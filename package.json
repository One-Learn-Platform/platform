		"@types/d3-scale": "^4.0.9",
		"@types/node": "^26.6.2",
		"bits-ui": "^2.19.2",
		"clsx": "^2.1.1",
		"d3-scale": "^4.0.2",
		"dayjs": "^1.11.23",
		"dompurify": "^3.4.15",
		"drizzle-kit": "^0.31.11",
		"drizzle-zod": "^0.8.3",
		"eslint": "^10.11.0",
