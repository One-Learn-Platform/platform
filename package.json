		"@types/d3-scale": "^4.0.9",
		"@types/node": "^26.6.5",
		"bits-ui": "^2.19.5",
		"clsx": "^2.1.1",
		"d3-scale": "^4.0.2",
		"dayjs": "^1.11.23",
		"dompurify": "^3.4.17",
		"drizzle-kit": "^0.31.11",
